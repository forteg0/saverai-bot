# --- WhatsApp (Meta Cloud API) ---
WHATSAPP_ACCESS_TOKEN=        # token del panel de Meta (permanente via System User, o temporal 24h)
WHATSAPP_PHONE_NUMBER_ID=     # Phone Number ID del numero de WhatsApp Business
WHATSAPP_VERIFY_TOKEN=        # lo elegis vos; el mismo que cargas en el webhook de Meta
WHATSAPP_APP_SECRET=          # opcional: valida la firma X-Hub-Signature-256 del webhook
WHATSAPP_GRAPH_VERSION=v21.0  # opcional

# --- Backend de CapsaAI (unico punto de contacto en runtime) ---
BACKEND_URL=http://localhost:4010
WHATSAPP_WEBHOOK_SECRET=      # el MISMO secreto que usa el backend para verificar la firma HMAC
BOT_PORT=4020

# --- IA (transcripcion + extraccion) ---
AI_PROVIDER=groq              # groq (gratis) | openai | custom
GROQ_API_KEY=
OPENAI_API_KEY=               # solo si AI_PROVIDER=openai
AI_BASE_URL=                  # solo si AI_PROVIDER=custom (backend compatible con la API de OpenAI)
AI_API_KEY=
WHISPER_MODEL=               # opcional (default segun proveedor)
EXPENSE_PARSER_MODEL=        # opcional (default segun proveedor)

# --- Opcionales del bot ---
BOT_DEBUG=                    # =1 para logs detallados paso a paso
BOT_DEFAULT_CARD=            # si se setea, usa siempre esa tarjeta y no pregunta

# --- Solo para el script de ops scripts/link-user.ts (unico que toca la BD) ---
DATABASE_URL=postgresql://capsa:password@localhost:5432/capsaai
